{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/portfolio/**/*",
    "src/trial/**/*"
  ],
  "exclude": [
    "dist",
    "dist-trial",
    "studio",
    "trial/tests",
    "dist-portfolio",
    "dist-public-test"
  ]
}
