# Optional: Google Search Console HTML tag verification token
# https://search.google.com/search-console
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: protected draft preview for the isolated Sanity trial.
# Viewer token stays server-side. Never use a PUBLIC_ prefix.
SANITY_API_READ_TOKEN=
# Generate a long random password; use it on the draft preview unlock page.
SANITY_PREVIEW_SECRET=
