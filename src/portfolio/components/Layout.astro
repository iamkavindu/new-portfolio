---
import '../style.css';
import type {Entry, Profile, Settings} from '../content';
import {imageUrl} from '../content';
import {absoluteUrl, serializeJSON, structuredData} from '../lib/seo';
interface Props {title: string; description?: string; name?: string; profile?: Profile | null; settings?: Settings | null; entry?: Entry; publishedPath?: string;}
const {title, profile, settings, entry, publishedPath} = Astro.props;
const name = Astro.props.name || profile?.name || 'Kavindu Perera';
const description = Astro.props.description || settings?.seo?.description || 'Writing and projects by Kavindu Perera.';
const pageTitle = title.includes(name) ? title : title === 'Home' ? `${name} · ${profile?.headline || 'Software engineer'}` : `${title} · ${name}`;
const escapedTitle = pageTitle.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const path = Astro.url.pathname;
const noIndex = Astro.locals.noIndex || (Astro.response.status || 200) >= 400;
const preview = Astro.locals.preview;
const publicPath = publishedPath || (preview ? '/' : path);
const canonical = absoluteUrl(publicPath);
const shareImage = imageUrl(entry?.seo?.image || entry?.coverImage || settings?.seo?.image || profile?.seo?.image) || absoluteUrl('/social-card.png');
const graph = structuredData(publicPath, title, description, profile, settings, entry);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const navigation = [['Home', '/'], ['Writing', '/writing/'], ['Work', '/work/'], ['About / CV', '/about/'], ['Contact', '/contact/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title set:html={escapedTitle} /><meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={entry?._type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:site_name" content={name} />
    <meta property="og:image" content={shareImage} /><meta property="og:image:alt" content={entry?.seo?.image?.alt || entry?.coverImage?.alt || `${name} — writing and projects`} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={shareImage} />
    <link rel="alternate" type="application/rss+xml" title={`${name} — Writing`} href={absoluteUrl('/rss.xml')} />
    {entry?.publishedAt && <meta property="article:published_time" content={entry.publishedAt} />}
    {entry?._updatedAt && <meta property="article:modified_time" content={entry._updatedAt} />}
    {verification && <meta name="google-site-verification" content={verification} />}
    <script is:inline type="application/ld+json" set:html={serializeJSON(graph)} />
  </>}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
<header class="site-header"><a class="brand" href="/" aria-label={`${name}, home`}>{name}<span aria-hidden="true">.</span></a><nav aria-label="Main navigation">{navigation.map(([label, href]) => <a href={href} aria-current={(href === '/' ? publicPath === href : publicPath.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav></header>
<main id="main" tabindex="-1">
  {preview && <aside class="preview-notice"><div><strong>Private draft preview</strong><p>Save in Studio, then refresh. Publishing updates the public version on its next request.</p><a href={publicPath} target="_blank" rel="noreferrer">Open published version ↗</a></div><form method="post" action="/preview/exit/"><button class="button" type="submit">Exit preview</button></form></aside>}
  <slot />
</main>
<footer><a class="brand" href="/">{name}<span>.</span></a><p>Ideas, experiments, and the things I build.</p><a href="/contact/">Let’s talk <span aria-hidden="true">↗</span></a></footer>
</div>
</body>
</html>
