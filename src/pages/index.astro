---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts, getFeaturedProjects } from '../lib/content';
import { SOCIAL, AUTHOR } from '../consts';

const posts = (await getPublishedPosts()).slice(0, 3);
const projects = await getFeaturedProjects();
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400 mb-3 tracking-wide uppercase">
      Backend · Systems · Java
    </p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
      Kavindu Perera
    </h1>
    <p class="mt-5 text-lg sm:text-xl text-surface-600 dark:text-surface-400 leading-relaxed max-w-2xl">
      I design and build reliable backend systems — microservices, APIs, and cloud-native pipelines —
      with a focus on clarity and scale.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/blog/"
        class="inline-flex items-center rounded-lg bg-accent-600 hover:bg-accent-500 text-white px-5 py-2.5 text-sm font-medium transition-colors"
      >
        Read the writing
      </a>
      <a
        href="/work/"
        class="inline-flex items-center rounded-lg border border-surface-300 dark:border-surface-700 px-5 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 hover:border-accent-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
      >
        Selected work
      </a>
    </div>
  </section>

  <!-- About teaser -->
  <section class="border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50">About</h2>
        <a href="/about/" class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
          More about me →
        </a>
      </div>
      <div class="prose">
        <p>
          Software engineer at <strong>{AUTHOR.worksFor}</strong>, focused on backend development with
          <strong>Java</strong> and <strong>Spring Boot</strong>. I care about systems that stay
          understandable under load — and I write about the trade-offs along the way.
        </p>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="border-t border-surface-200 dark:border-surface-800" aria-labelledby="writing-heading">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-8">
        <h2 id="writing-heading" class="text-2xl font-semibold text-surface-900 dark:text-surface-50">
          Writing
        </h2>
        <a href="/blog/" class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
          View all →
        </a>
      </div>

      {
        posts.length === 0 ? (
          <p class="text-surface-600 dark:text-surface-400">No posts published yet.</p>
        ) : (
          <ul class="space-y-8">
            {posts.map((post) => (
              <li>
                <PostCard post={post} variant="home" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="border-t border-surface-200 dark:border-surface-800" aria-labelledby="work-heading">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-8">
        <h2 id="work-heading" class="text-2xl font-semibold text-surface-900 dark:text-surface-50">
          Selected work
        </h2>
        <a href="/work/" class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
          View all →
        </a>
      </div>

      {
        projects.length === 0 ? (
          <p class="text-surface-600 dark:text-surface-400">Case studies coming soon.</p>
        ) : (
          <ul class="space-y-8">
            {projects.map((project) => (
              <li>
                <ProjectCard project={project} variant="home" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Contact teaser -->
  <section class="border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50 mb-4">Get in touch</h2>
      <p class="text-surface-600 dark:text-surface-400 mb-6 max-w-xl">
        Open to conversations about backend systems, open source, or interesting problems.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center rounded-lg bg-accent-600 hover:bg-accent-500 text-white px-5 py-2.5 text-sm font-medium transition-colors"
        >
          Contact
        </a>
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-surface-300 dark:border-surface-700 px-5 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 hover:border-accent-500 transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
