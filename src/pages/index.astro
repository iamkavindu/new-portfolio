---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL, AUTHOR } from '../consts';

const posts = (await getCollection('blogs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400 mb-3 tracking-wide uppercase">
      Backend · Systems · Java
    </p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
      Kavindu Perera
    </h1>
    <p class="mt-5 text-lg sm:text-xl text-surface-600 dark:text-surface-400 leading-relaxed max-w-2xl">
      I design and build reliable backend systems — microservices, APIs, and cloud-native pipelines —
      with a focus on clarity and scale.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/blog/"
        class="inline-flex items-center rounded-lg bg-accent-600 hover:bg-accent-500 text-white px-5 py-2.5 text-sm font-medium transition-colors"
      >
        Read the writing
      </a>
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-lg border border-surface-300 dark:border-surface-700 px-5 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 hover:border-accent-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
      >
        GitHub
      </a>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50 mb-6">About</h2>
      <div class="prose">
        <p>
          I'm a software engineer at <strong>{AUTHOR.worksFor}</strong>, focused on backend development
          with <strong>Java</strong> and <strong>Spring Boot</strong>.
        </p>
        <p>
          I care about systems that stay understandable under load: clear service boundaries,
          event-driven flows, and APIs that are easy to evolve. Outside of work I write about
          architecture, tooling, and the problems I run into building real systems.
        </p>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50">Writing</h2>
        <a href="/blog/" class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
          View all →
        </a>
      </div>

      {
        posts.length === 0 ? (
          <p class="text-surface-600 dark:text-surface-400">No posts published yet.</p>
        ) : (
          <ul class="space-y-8">
            {posts.map((post) => (
              <li>
                <article>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-sm text-surface-500 dark:text-surface-500"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <h3 class="mt-1 text-lg font-semibold">
                    <a
                      href={`/blog/${post.id}/`}
                      class="text-surface-900 dark:text-surface-50 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-1.5 text-surface-600 dark:text-surface-400 leading-relaxed">
                    {post.data.description}
                  </p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Work teaser -->
  <section class="border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50">Selected work</h2>
        <a href="/work/" class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline">
          View all →
        </a>
      </div>
      <p class="text-surface-600 dark:text-surface-400">
        Case studies for projects like stream-app and Java-TS-Gen will live here.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-20 border-t border-surface-200 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-semibold text-surface-900 dark:text-surface-50 mb-4">Get in touch</h2>
      <p class="text-surface-600 dark:text-surface-400 mb-6 max-w-xl">
        Open to conversations about backend systems, open source, or interesting problems.
        Reach me on LinkedIn or GitHub.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
        >
          LinkedIn →
        </a>
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
        >
          GitHub →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
