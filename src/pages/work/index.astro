---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedProjects } from '../../lib/content';

const projects = await getPublishedProjects();
---

<BaseLayout title="Work" description="Selected projects and case studies by Kavindu Perera.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 mb-3">
      Work
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-12 max-w-xl">
      Selected projects — architecture, trade-offs, and outcomes.
    </p>

    {
      projects.length === 0 ? (
        <p class="text-surface-500 dark:text-surface-500">Case studies coming soon.</p>
      ) : (
        <ul class="space-y-10">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} variant="list" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
