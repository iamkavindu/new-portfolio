---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Work" description="Selected projects and case studies by Kavindu Perera.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 mb-3">
      Work
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-12 max-w-xl">
      Selected projects — architecture, trade-offs, and outcomes.
    </p>

    {
      projects.length === 0 ? (
        <p class="text-surface-500 dark:text-surface-500">Case studies coming soon.</p>
      ) : (
        <ul class="space-y-10">
          {projects.map((project) => (
            <li>
              <article>
                <h2 class="text-xl font-semibold">
                  <a
                    href={`/work/${project.id}/`}
                    class="text-surface-900 dark:text-surface-50 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
                  >
                    {project.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-surface-600 dark:text-surface-400 leading-relaxed">
                  {project.data.description}
                </p>
                {
                  project.data.stack.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {project.data.stack.map((tag) => (
                        <li class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )
                }
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
