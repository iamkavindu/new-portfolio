---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SOCIAL } from '../consts';

const hasEmail = Boolean(AUTHOR.email?.trim());
---

<BaseLayout
  title="Contact"
  description={`Contact ${AUTHOR.name} — open to conversations about backend systems, open source, and opportunities.`}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400 mb-3 tracking-wide uppercase">
      Contact
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
      Get in touch
    </h1>
    <p class="mt-4 text-lg text-surface-600 dark:text-surface-400 leading-relaxed max-w-xl">
      Open to conversations about backend systems, open source, interesting problems, and roles where
      clarity and reliability matter.
    </p>

    <ul class="mt-12 space-y-6">
      <li class="rounded-lg border border-surface-200 dark:border-surface-800 p-5">
        <h2 class="font-semibold text-surface-900 dark:text-surface-50">LinkedIn</h2>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">
          Best for professional introductions and opportunities.
        </p>
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
        >
          linkedin.com/in/iamkavindu →
        </a>
      </li>

      <li class="rounded-lg border border-surface-200 dark:border-surface-800 p-5">
        <h2 class="font-semibold text-surface-900 dark:text-surface-50">GitHub</h2>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">
          Code, issues, and collaboration on open source.
        </p>
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
        >
          github.com/iamkavindu →
        </a>
      </li>

      {
        hasEmail && (
          <li class="rounded-lg border border-surface-200 dark:border-surface-800 p-5">
            <h2 class="font-semibold text-surface-900 dark:text-surface-50">Email</h2>
            <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">
              For direct messages when LinkedIn is not ideal.
            </p>
            <a
              href={`mailto:${AUTHOR.email}`}
              class="mt-3 inline-flex text-sm font-medium text-accent-600 dark:text-accent-400 hover:underline"
            >
              {AUTHOR.email} →
            </a>
          </li>
        )
      }
    </ul>

    <p class="mt-10 text-sm text-surface-500 dark:text-surface-500">
      Prefer to browse first? See{' '}
      <a href="/work/" class="text-accent-600 dark:text-accent-400 hover:underline">selected work</a>
      {' '}or{' '}
      <a href="/blog/" class="text-accent-600 dark:text-accent-400 hover:underline">writing</a>.
    </p>
  </div>
</BaseLayout>
