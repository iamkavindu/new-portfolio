---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blogs', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}/`, SITE_URL).href,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  image={post.data.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <header class="mb-10">
      <a
        href="/blog/"
        class="text-sm font-medium text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
      >
        ← Writing
      </a>
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
        {post.data.title}
      </h1>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="mt-3 block text-sm text-surface-500 dark:text-surface-500"
      >
        {formattedDate}
      </time>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
