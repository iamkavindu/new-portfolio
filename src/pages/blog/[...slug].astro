---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Takeaways from '../../components/Takeaways.astro';
import { AUTHOR, SITE_URL } from '../../consts';
import {
  formatDate,
  readingTimeLabel,
  readingTimeMinutes,
  getGuide,
} from '../../lib/content';
import { ogImagePath } from '../../lib/og';

export async function getStaticPaths() {
  const posts = await getCollection('blogs', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const pageUrl = new URL(`/blog/${post.id}/`, SITE_URL).href;
const modified = post.data.updatedDate ?? post.data.pubDate;
const wasUpdated =
  post.data.updatedDate !== undefined &&
  post.data.updatedDate.valueOf() !== post.data.pubDate.valueOf();
const readLabel = readingTimeLabel(post.body);
const readMins = readingTimeMinutes(post.body);
const guide = post.data.guide ? await getGuide(post.data.guide) : undefined;

/** Prefer custom hero; else build-time OG PNG */
const shareImage = post.data.heroImage ?? ogImagePath('blog', post.id);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modified.toISOString(),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  keywords: post.data.tags.join(', '),
  inLanguage: 'en',
  timeRequired: `PT${readMins}M`,
  image: new URL(shareImage, SITE_URL).href,
};

const breadcrumbItems = [
  { '@type': 'ListItem' as const, position: 1, name: 'Home', item: SITE_URL },
  {
    '@type': 'ListItem' as const,
    position: 2,
    name: 'Writing',
    item: new URL('/blog/', SITE_URL).href,
  },
];

if (guide) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: guide.data.title,
    item: new URL(`/blog/guides/${guide.id}/`, SITE_URL).href,
  });
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 4,
    name: post.data.title,
    item: pageUrl,
  });
} else {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: post.data.title,
    item: pageUrl,
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={modified.toISOString()}
  image={shareImage}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <a
          href="/blog/"
          class="font-medium text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        >
          ← Writing
        </a>
        <span class="text-surface-400 dark:text-surface-600" aria-hidden="true">·</span>
        <a
          href="#article-body"
          class="font-medium text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        >
          Skip to article
        </a>
      </div>

      {
        guide && (
          <p class="mt-4 text-sm text-surface-600 dark:text-surface-400">
            Part of the guide:{' '}
            <a
              href={`/blog/guides/${guide.id}/`}
              class="font-medium text-accent-600 dark:text-accent-400 hover:underline"
            >
              {guide.data.title}
            </a>
          </p>
        )
      }

      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
        {post.data.title}
      </h1>

      {
        post.data.description && (
          <p class="mt-3 text-lg text-surface-600 dark:text-surface-400 leading-relaxed">
            {post.data.description}
          </p>
        )
      }

      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-surface-500 dark:text-surface-500">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          wasUpdated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated{' '}
                <time datetime={post.data.updatedDate!.toISOString()}>
                  {formatDate(post.data.updatedDate!)}
                </time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readLabel}</span>
      </p>

      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <Takeaways items={post.data.takeaways} />
    <TableOfContents headings={headings} />

    <div id="article-body" class="prose scroll-mt-20">
      <Content />
    </div>
  </article>
</BaseLayout>
