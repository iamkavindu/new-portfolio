---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, SITE_URL, DEFAULT_OG_IMAGE } from '../../consts';
import { formatDate, readingTimeLabel } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blogs', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageUrl = new URL(`/blog/${post.id}/`, SITE_URL).href;
const modified = post.data.updatedDate ?? post.data.pubDate;
const readLabel = readingTimeLabel(post.body);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modified.toISOString(),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  keywords: post.data.tags.join(', '),
  inLanguage: 'en',
  timeRequired: `PT${Math.max(1, Math.ceil(post.body.split(/\s+/).length / 200))}M`,
  image: post.data.heroImage
    ? new URL(post.data.heroImage, SITE_URL).href
    : new URL(DEFAULT_OG_IMAGE, SITE_URL).href,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Writing',
      item: new URL('/blog/', SITE_URL).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={modified.toISOString()}
  image={post.data.heroImage ?? DEFAULT_OG_IMAGE}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <header class="mb-10">
      <a
        href="/blog/"
        class="text-sm font-medium text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
      >
        ← Writing
      </a>
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
        {post.data.title}
      </h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-surface-500 dark:text-surface-500">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readLabel}</span>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
