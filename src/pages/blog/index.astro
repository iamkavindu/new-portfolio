---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blogs', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="Writing" description="Articles on backend systems, Java, Spring Boot, and cloud architecture.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 mb-3">
      Writing
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-12 max-w-xl">
      Notes on building backend systems, tooling, and the trade-offs that show up in production.
    </p>

    {
      posts.length === 0 ? (
        <p class="text-surface-500 dark:text-surface-500">No posts yet. Content migration is next.</p>
      ) : (
        <ul class="space-y-10">
          {posts.map((post) => (
            <li>
              <article>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-sm text-surface-500 dark:text-surface-500"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <h2 class="mt-1 text-xl font-semibold">
                  <a
                    href={`/blog/${post.id}/`}
                    class="text-surface-900 dark:text-surface-50 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-surface-600 dark:text-surface-400 leading-relaxed">
                  {post.data.description}
                </p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
