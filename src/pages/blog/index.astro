---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getPublishedGuides } from '../../lib/content';

const posts = await getPublishedPosts();
const guides = await getPublishedGuides();
---

<BaseLayout title="Writing" description="Articles on backend systems, Java, Spring Boot, and cloud architecture.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 mb-3">
      Writing
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-6 max-w-xl">
      Notes on building backend systems, tooling, and the trade-offs that show up in production.
    </p>

    {
      guides.length > 0 && (
        <p class="mb-12 text-sm">
          <a
            href="/blog/guides/"
            class="font-medium text-accent-600 dark:text-accent-400 hover:underline"
          >
            Browse topic guides →
          </a>
        </p>
      )
    }

    {
      posts.length === 0 ? (
        <p class="text-surface-500 dark:text-surface-500">No posts yet.</p>
      ) : (
        <ul class="space-y-10">
          {posts.map((post) => (
            <li>
              <PostCard post={post} variant="list" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
