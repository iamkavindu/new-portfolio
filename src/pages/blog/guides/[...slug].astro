---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPostsForGuide } from '../../../lib/content';
import { SITE_URL } from '../../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const posts = await getPostsForGuide(guide.id);

const pageUrl = new URL(`/blog/guides/${guide.id}/`, SITE_URL).href;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: guide.data.title,
  description: guide.data.description,
  url: pageUrl,
  numberOfItems: posts.length,
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.id}/`, SITE_URL).href,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Writing',
      item: new URL('/blog/', SITE_URL).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Guides',
      item: new URL('/blog/guides/', SITE_URL).href,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: guide.data.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <p class="text-sm font-medium text-surface-500 mb-3">
      <a href="/blog/" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        Writing
      </a>
      <span class="text-surface-400 dark:text-surface-600"> / </span>
      <a
        href="/blog/guides/"
        class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
      >
        Guides
      </a>
    </p>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50 text-balance">
      {guide.data.title}
    </h1>
    <p class="mt-3 text-lg text-surface-600 dark:text-surface-400 leading-relaxed">
      {guide.data.description}
    </p>

    <div class="prose mt-8 mb-12">
      <Content />
    </div>

    <h2 class="text-xl font-semibold text-surface-900 dark:text-surface-50 mb-6">
      Posts in this guide
    </h2>

    {
      posts.length === 0 ? (
        <p class="text-surface-500">No published posts in this guide yet.</p>
      ) : (
        <ol class="space-y-10">
          {posts.map((post, i) => (
            <li class="relative">
              <span
                class="absolute -left-0 sm:-left-8 top-1 text-sm font-mono text-surface-400 dark:text-surface-600 tabular-nums hidden sm:block"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <PostCard post={post} variant="list" />
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>
