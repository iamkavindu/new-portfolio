---
import { SITE_TITLE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-200 dark:border-surface-800 mt-auto">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-surface-500 dark:text-surface-500">
      &copy; {year} {SITE_TITLE}
    </p>
    <div class="flex items-center gap-5">
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        aria-label="GitHub"
      >
        GitHub
      </a>
      <a
        href={SOCIAL.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        aria-label="LinkedIn"
      >
        LinkedIn
      </a>
      <a
        href="/rss.xml"
        class="text-sm text-surface-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        aria-label="RSS feed"
      >
        RSS
      </a>
    </div>
  </div>
</footer>
