---
import type { ProjectEntry } from '../lib/content';

interface Props {
  project: ProjectEntry;
  variant?: 'home' | 'list';
}

const { project, variant = 'list' } = Astro.props;
---

<article class="group">
  <h3 class:list={['font-semibold', variant === 'home' ? 'text-lg' : 'text-xl']}>
    <a
      href={`/work/${project.id}/`}
      class="text-surface-900 dark:text-surface-50 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
    >
      {project.data.title}
    </a>
  </h3>
  <p class="mt-1.5 text-surface-600 dark:text-surface-400 leading-relaxed">
    {project.data.description}
  </p>
  {
    project.data.stack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {project.data.stack.slice(0, variant === 'home' ? 5 : undefined).map((tag) => (
          <li class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
