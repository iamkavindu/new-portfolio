---
import TrialLayout from '../TrialLayout.astro';
import {previewCookie, sessionSeconds, sameSecret, createSession, safeReturnPath} from '../auth';
const secret = process.env.SANITY_PREVIEW_SECRET || import.meta.env.SANITY_PREVIEW_SECRET || '';
const configured = secret.length >= 24;
let message = '';
let next = safeReturnPath(Astro.url.searchParams.get('next'));
if (Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');
  if (origin !== Astro.url.origin) { Astro.response.status = 403; message = 'Please submit this form from the preview page.'; }
  else {
    const form = await Astro.request.formData();
    next = safeReturnPath(String(form.get('next') || ''));
    if (sameSecret(String(form.get('password') || ''), secret)) {
      Astro.cookies.set(previewCookie, createSession(secret), {httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/trial/', maxAge: sessionSeconds});
      return Astro.redirect(next, 303);
    }
    Astro.response.status = 401; message = 'The preview password did not match.';
  }
}
---
<TrialLayout title="Unlock draft preview"><section class="intro"><p class="eyebrow">Private preview</p><h1>See your draft.</h1>{configured ? <><p>Enter the preview password from your local environment configuration.</p><form method="post"><input type="hidden" name="next" value={next} /><label for="preview-password">Preview password</label><input id="preview-password" name="password" type="password" required autocomplete="current-password" /><button type="submit">Open preview</button></form>{message && <p role="alert">{message}</p>}</> : <p>First configure SANITY_PREVIEW_SECRET (at least 24 characters) in the root .env file and restart the trial server. See SANITY-TRIAL.md.</p>}</section></TrialLayout>
