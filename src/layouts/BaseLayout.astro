---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  AUTHOR,
  SOCIAL,
  DEFAULT_OG_IMAGE,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const pageTitle = title === SITE_TITLE ? `${SITE_TITLE} · Software Engineer` : `${title} · ${SITE_TITLE}`;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE_URL).href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isPng = ogImage.endsWith('.png') || ogImage.includes('.png?');

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  jobTitle: AUTHOR.jobTitle,
  url: SITE_URL,
  sameAs: [SOCIAL.github, SOCIAL.linkedin, SOCIAL.medium],
  worksFor: {
    '@type': 'Organization',
    name: AUTHOR.worksFor,
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  author: { '@type': 'Person', name: AUTHOR.name },
  inLanguage: 'en',
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={new URL('/rss.xml', SITE_URL).href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={AUTHOR.name} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    {isPng && <meta property="og:image:type" content="image/png" />}
    {isPng && <meta property="og:image:width" content="1200" />}
    {isPng && <meta property="og:image:height" content="630" />}
    <meta property="og:site_name" content={SITE_TITLE} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content={AUTHOR.name} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'dark';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>

    {
      isHome && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      )
    }
    {
      isHome && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent-500 focus:text-accent-fg focus:rounded-md"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
